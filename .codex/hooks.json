{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/.codex/hooks/eslint-apply-patch.sh\"",
            "statusMessage": "Running ESLint on edited files"
          }
        ]
      }
    ]
  }
}
